rules_version = '2';

// Attendance Management System — Firestore Security Rules
//
// Authoritative access control. The Flutter UI only hides unauthorised actions;
// these rules enforce them. There is no server tier: privileged operations
// (provisioning accounts, bulk import) run from the manager's client and are
// validated here. Auth-account creation happens on a throwaway secondary app so
// the manager's session survives; a client cannot disable or delete another
// user's Auth record, so deactivation is the `isActive` flag below and account
// deletion removes the profile only.
//
// Role / permission matrix: see SECURITY.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isActive() {
      return userDoc().isActive == true;
    }

    function hasRole(r) {
      return isSignedIn() && isActive() && role() == r;
    }

    function isInternal() {
      return isSignedIn() && isActive()
        && role() in ['security', 'manager', 'supervisor'];
    }

    // Parent ↔ student link, validated server-side. Never trust a studentId
    // supplied by the client without this check.
    function parentOwnsStudent(studentId) {
      return hasRole('parent') && studentId in userDoc().studentIds;
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // Rule 4: an attendance record may only be written for a real,
    // already-registered student/worker — never trust a personId supplied by
    // the client without this check.
    function personExists(personType, personId) {
      return personType == 'student'
        ? exists(/databases/$(database)/documents/students/$(personId))
        : exists(/databases/$(database)/documents/workers/$(personId));
    }

    // Fields that must not change between the stored and incoming document.
    function unchanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(keys) == false;
    }

    // ---- users --------------------------------------------------------
    match /users/{uid} {
      // Own profile always; internal staff may read others for lookup.
      allow read: if isSignedIn() && (request.auth.uid == uid || isInternal());

      // A manager provisions accounts directly. The Auth user is created first
      // (secondary app), then this profile is written and validated here.
      // A supervisor may only provision security and parent accounts.
      allow create: if (hasRole('manager') || hasRole('supervisor'))
        && request.resource.data.uid == uid
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.email)
        && request.resource.data.role in (
          hasRole('manager')
            ? ['security', 'manager', 'supervisor', 'parent']
            : ['security', 'parent'])
        && request.resource.data.isActive == true;

      // Manager may change isActive and (for parents) studentIds. A supervisor
      // may do the same, but only for security and parent accounts. Identity and
      // audit fields are locked.
      allow update: if (hasRole('manager')
          || (hasRole('supervisor')
              && resource.data.role in ['security', 'parent']))
        && unchanged(['uid', 'email', 'role', 'createdAt', 'createdBy']);

      // Only the manager may delete accounts.
      allow delete: if hasRole('manager');
    }

    // ---- metadata (sequential id counters) -------------------------
    match /metadata/{doc} {
      // Supervisor: the Excel import reserves id ranges on the counters doc.
      allow read, write: if hasRole('manager') || hasRole('supervisor');
    }

    // ---- students ----------------------------------------------------
    match /students/{studentId} {
      allow read: if isInternal() || parentOwnsStudent(studentId);

      // Supervisor may create and update but never delete.
      allow create: if (hasRole('manager') || hasRole('supervisor'))
        && request.resource.data.studentId == studentId
        && request.resource.data.qrCodeId == studentId
        && isNonEmptyString(request.resource.data.fullName)
        && isNonEmptyString(request.resource.data.className);

      allow update: if (hasRole('manager') || hasRole('supervisor'))
        && unchanged(['studentId', 'qrCodeId', 'createdAt'])
        && isNonEmptyString(request.resource.data.fullName)
        && isNonEmptyString(request.resource.data.className);

      allow delete: if hasRole('manager');
    }

    // ---- workers ---------------------------------------------------
    match /workers/{workerId} {
      allow read: if isInternal();

      // Supervisor may create and update but never delete.
      allow create: if (hasRole('manager') || hasRole('supervisor'))
        && request.resource.data.workerId == workerId
        && request.resource.data.qrCodeId == workerId
        && isNonEmptyString(request.resource.data.fullName)
        && request.resource.data.jobTitle in ['teacher', 'administrative_staff', 'other'];

      allow update: if (hasRole('manager') || hasRole('supervisor'))
        && unchanged(['workerId', 'qrCodeId', 'createdAt'])
        && isNonEmptyString(request.resource.data.fullName)
        && request.resource.data.jobTitle in ['teacher', 'administrative_staff', 'other'];

      allow delete: if hasRole('manager');
    }

    // ---- attendance ----------------------------------------------
    match /attendance/{attendanceId} {
      // Internal staff view all; parents view only their child's.
      allow read: if isInternal()
        || (resource.data.personType == 'student'
            && parentOwnsStudent(resource.data.personId));

      // Security records or corrects attendance (Rules 9–11); a manager may also
      // write it for the one-time historical Excel import. Business state rules
      // (Rules 1–3) are enforced transactionally in the client and cannot be
      // expressed here; identity fields are locked down instead.
      // The supervisor may also write it, for the same Excel import.
      allow create: if (hasRole('security') || hasRole('manager') || hasRole('supervisor'))
        && request.resource.data.personType in ['student', 'worker']
        && request.resource.data.date is string
        && request.resource.data.personId is string
        && personExists(request.resource.data.personType, request.resource.data.personId);

      // (The import merges into existing records, so it needs update as well.)
      allow update: if (hasRole('security') || hasRole('manager') || hasRole('supervisor'))
        && unchanged(['personId', 'personType', 'date',
                      'checkInRecordedBy', 'checkInRecordedAt']);

      allow delete: if false;
    }

    // ---- pickupRequests -----------------------------------------
    match /pickupRequests/{requestId} {
      allow read: if isInternal()
        || (hasRole('parent') && resource.data.parentId == request.auth.uid);

      allow create: if hasRole('parent')
        && request.resource.data.parentId == request.auth.uid
        && parentOwnsStudent(request.resource.data.studentId)
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && isNonEmptyString(request.resource.data.studentName)
        && isNonEmptyString(request.resource.data.parentName);

      // Security transitions status; a parent may only cancel their own.
      allow update: if unchanged(['studentId', 'parentId', 'requestedAt'])
        && (
          hasRole('security')
          || (hasRole('parent')
              && resource.data.parentId == request.auth.uid
              && request.resource.data.status == 'cancelled')
        );

      allow delete: if false;
    }

    // ---- pickupActive (per-student active-request guard) -----------
    match /pickupActive/{studentId} {
      allow read: if isInternal()
        || (hasRole('parent') && parentOwnsStudent(studentId));

      allow create: if hasRole('parent')
        && parentOwnsStudent(studentId)
        && request.resource.data.parentId == request.auth.uid;

      allow delete: if hasRole('security')
        || (hasRole('parent') && parentOwnsStudent(studentId));

      allow update: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
